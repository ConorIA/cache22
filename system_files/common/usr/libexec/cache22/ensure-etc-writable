#!/usr/bin/env bash
# ensure-etc-writable — fallback that makes /etc a writable bind-on-self if it
# isn't already.
#
# Under the composefs backend ostree sets /etc up as a writable overlay itself
# (on hard boot and on `ostree admin prepare-soft-reboot`), so this script
# defers there. It stays as a safety net for the legacy backend: if a deploy
# falls back to the legacy bind-mount (composefs.enabled = maybe) and /etc ends
# up read-only, re-establish a writable bind. Idempotent: when /etc is already a
# writable mount it exits without touching anything.

set -euo pipefail

# Only relevant for ostree-booted systems.
[[ -f /run/ostree-booted ]] || exit 0

# composefs handles /etc itself; don't interfere. Detect by the actual root
# mount type rather than the prepare-root.conf value, so 'enabled = maybe'
# (composefs only when the deploy has a .cfs) is handled correctly: under
# composefs the root is an overlay/erofs mount, under legacy it is the plain
# deploy filesystem (btrfs/xfs/ext4).
case "$(findmnt -no FSTYPE / 2>/dev/null || true)" in
    overlay|erofs) exit 0 ;;
esac

# Already its own mount?
if findmnt /etc >/dev/null 2>&1; then
    if findmnt -no OPTIONS /etc | grep -qE '(^|,)rw(,|$)'; then
        exit 0  # already RW, nothing to do
    fi
    mount -o remount,bind,rw /etc
    echo "ensure-etc-writable: remounted existing /etc bind as rw"
    exit 0
fi

# /etc is just-a-dir on the (RO) root mount. Bind it on itself, then
# remount RW.
mount --bind /etc /etc
mount -o remount,bind,rw /etc
echo "ensure-etc-writable: established /etc as writable bind"
